#!/usr/bin/env bash
# Local development, same shape as production:
#
#   browser -> Vite dev server (:20000) --/api/*--> Go API (:20002) -> Postgres (docker, :20001)
#
# Open http://localhost:20000. Ctrl-C stops the API and Vite; the database container keeps running.
#
# On first run the dev database is seeded from ./crossword_production.dump if it exists and the
# database is empty. Optional overrides: DB_URL, WEB_PORT, API_PORT, or ENV_FILE=<file> to source.
set -euo pipefail
cd "$(dirname "$0")/.."

if [[ -n ${ENV_FILE:-} ]]; then
  set -a
  # shellcheck disable=SC1090
  source "$ENV_FILE"
  set +a
fi

DEV_DB=crossword_development
DEV_DB_URL="postgres://postgres:postgres@localhost:20001/$DEV_DB"
DB_URL=${DB_URL:-$DEV_DB_URL}
WEB_PORT=${WEB_PORT:-20000}
API_PORT=${API_PORT:-20002}
export DB_URL

db() { docker compose --profile dev exec -T dev-database "$@"; }

echo "[dev] starting database..."
docker compose --profile dev up -d --wait dev-database

if [[ $DB_URL == "$DEV_DB_URL" ]]; then
  if ! db psql -U postgres -tAc "select 1 from pg_database where datname = '$DEV_DB'" | grep -q 1; then
    echo "[dev] creating $DEV_DB..."
    db createdb -U postgres "$DEV_DB"
  fi
  users=$(db psql -U postgres -d "$DEV_DB" -tAc "select count(*) from users" 2>/dev/null || echo 0)
  if [[ $users == 0 ]]; then
    if [[ -f crossword_production.dump ]]; then
      echo "[dev] seeding $DEV_DB from crossword_production.dump..."
      db pg_restore --clean --if-exists --no-owner --no-privileges -U postgres -d "$DEV_DB" <crossword_production.dump
    else
      echo "[dev] warning: $DEV_DB is empty and crossword_production.dump is missing; pages will be blank" >&2
    fi
  fi
fi

if [[ ! -d frontend/node_modules || frontend/package-lock.json -nt frontend/node_modules/.package-lock.json ]]; then
  echo "[dev] installing frontend dependencies..."
  (cd frontend && npm install)
fi

echo "[dev] building api..."
(cd backend && go build -o tmp/crossword ./cmd/crossword)

# `exec` makes $! the server itself, so the trap below stops exactly that process.
(cd backend && PORT=$API_PORT exec ./tmp/crossword server) > >(awk '{ print "[api] " $0; fflush() }') 2>&1 &
API_PID=$!
trap 'kill "$API_PID" 2>/dev/null || true' EXIT

# Vite stays in the foreground so it keeps its colors and keyboard shortcuts.
cd frontend
API_PROXY_TARGET="http://localhost:$API_PORT" npx vite --port "$WEB_PORT"
